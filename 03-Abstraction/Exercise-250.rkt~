;; ListOfNumber is one of:
;; - empty
;; - (cons Number ListOfNumber)
;; reperesents a list of number.

(define LON-0 empty)
(define LON-1 (list 4))
(define LON-2 (list 4 1))

#;
(define (fn-for-lon lon)
  (cond [(empty? lon) (...)]
        [else
         (... (first lon)
              (fn-for-lon (rest lon)))]))

