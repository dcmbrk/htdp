(define PI 3.141)


;; Functions
;; =========

;; Natural -> Number
;; Add pi to natural

(check-expect (add-pi 0) PI)
(check-expect (add-pi 1) (+ 1 PI))
(check-expect (add-pi 2) (+ 1 1 PI))

;(define (add-pi n) 0)

(define (add-pi n)
  (if (zero? n)
      PI
      (add1 (add-pi (sub1 n)))))