;; Numbers is one of:
;; - empty
;; - (cons Number Numbers)
;; interp. a list of numbers.

#;
(define (fn-for-numbers numbers)
  (cond [(empty? numbers) (...)]
        [else
         (... (first numbers)
              (fn-for-numbers (rest numbers)))]))


