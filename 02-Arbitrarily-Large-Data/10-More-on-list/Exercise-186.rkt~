;; Numbers -> Boolean
;; Determines if list of numbers are sorted.
(check-expect (sorted? empty) #true)
(check-expect (sorted? (list 1)) #true)
(check-expect (sorted? (list 2 1)) #true)
(check-expect (sorted? (list 1 2)) #false)

(define (sorted? numbers)
  (cond [(empty? numbers) #true]
        [(empty? (rest numbers)) #true]
        [else
         (and (> (first numbers) (second numbers))
              (sorted? (rest numbers)))]))

;; Numbers -> Numbers
;; Produces a sorted version of list
