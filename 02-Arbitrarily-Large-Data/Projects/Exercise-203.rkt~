;; DATE
(define DATE-1 (create-date 2020 5 15 14 30 0))
(define DATE-2 (create-date 2023 11 1 9 15 45))

;; TRACK
(define TRACK-1
  (create-track "Wild Child" "Enya" "A Day Without Rain" 227996 2 DATE-1 20 DATE-2))
(define TRACK-2
  (create-track "Only Time" "Enya" "A Day Without Rain" 218000 3 DATE-1 15 DATE-2))

;; TRACKS
(define TRACKS-0 empty)
(define TRACKS-1 (list TRACK-1))
(define TRACKS-2 (list TRACK-1 TRACK-2))

;; Functions
;; =========

;; Tracks -> Number
;; produces total amount of play time.
(check-expect (total-time empty) 0)
(check-expect (total-time TRACKS-1) (track-time# TRACK-1))
(check-expect (total-time TRACKS-2)
              (+ (track-time# TRACK-1)
                 (track-time# TRACK-2)))

;(define (total-time tracks) 0)

(define (total-time tracks)
  (cond [(empty? tracks) 0]
        [else
         (+ (track-time# (first tracks))
            (total-time (rest tracks)))]))

;; Tracks -> ListOfString
;; produces list of album from given tracks.
(check-expect (select-all-album-titles empty) empty)
(check-expect (select-all-album-titles TRACKS-1) (list (track-album TRACK-1)))
(check-expect (select-all-album-titles TRACKS-2) (list (track-album TRACK-1) (track-album TRACK-2)))

#;
(define (select-all-album-titles tracks) empty)

(define (select-all-album-titles tracks)
  (cond [(empty? tracks) empty]
        [else
         (cons (track-album (first tracks))
               (select-all-album-titles (rest tracks)))]))

;; ListOfString -> ListOfString
;; produces set of string without doubles.
(check-expect (create-set empty) empty)
(check-expect (create-set (list "a" "b"))
              (list "a" "b"))
(check-expect (create-set (list "a" "b" "b"))
              (list "a" "b"))
(check-expect (create-set (list "a" "b" "a"))
              (list "b" "a"))
(check-expect (create-set (list "a"))
              (list "a"))

#;
(define (create-set los) empty)

(define (create-set los)
  (cond [(empty? los) empty]                   
        [else                                  
         (if (member? (first los) (rest los))
             (create-set (rest los))
             (cons (first los) (create-set (rest los))))]))

;; Tracks -> ListOfString
;; produces list of unique album from given tracks.
(check-expect (select-album-titles/unique empty) empty)
(check-expect (select-album-titles/unique TRACKS-1) (list (track-album TRACK-1)))
(check-expect (select-album-titles/unique TRACKS-2) (list (track-album TRACK-1)))

#;
(define (select-album-titles/unique tracks) empty)

(define (select-album-titles/unique tracks)
  (create-set (select-all-album-titles tracks)))


;; String Tracks -> Tracks
;; filters tracks in given album.
(check-expect (select-album "A Day Without Rain" empty) empty)
(check-expect (select-album "A Day With Rain" TRACKS-1) empty)
(check-expect (select-album "A Day Without Rain" TRACKS-1) TRACKS-1)
(check-expect (select-album "A Day Without Rain" TRACKS-2) TRACKS-2)

#;
(define (select-album album tracks) empty)

(define (select-album album tracks)
  (cond [(empty? tracks) empty]
        [else
         (if (in-album? album (first tracks))
              (cons (first tracks) (select-album album (rest tracks)))
              (select-album album (rest tracks)))]))

;; String Track -> Boolean
;; determines if track is in album.
(check-expect (in-album? (track-album TRACK-1) TRACK-1) #true)
(check-expect (in-album? "A Day With Rain" TRACK-1) #false)

#;
(define (in-album? album track) #false)

(define (in-album? album track)
  (string=? album
            (track-album track)))